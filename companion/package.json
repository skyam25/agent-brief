{
  "name": "agent-brief-app",
  "version": "0.5.5",
  "private": true,
  "description": "Floating sketch, notes and voice panel that hands work to Claude Code.",
  "author": "skyam25",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "compile": "node scripts/sync-plugin.mjs --check && tsc --noEmit",
    "dist": "pnpm build && node -e \"require('electron')\" && electron-builder --mac --dir",
    "dist:notarize": "APPLE_KEYCHAIN_PROFILE=companion-notary pnpm dist",
    "release": "node scripts/release.mjs",
    "install:local": "node scripts/install-local.mjs",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "sync:plugin": "node scripts/sync-plugin.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "electron-updater": "6.8.9",
    "parse5": "7.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "productName": "Agent Brief",
  "main": "out/main/index.cjs"
}
